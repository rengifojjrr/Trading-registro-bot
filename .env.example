# Copy this file to .env.local for local development ("cp .env.example .env.local")
# and fill in real values there. .env.local is gitignored -- never commit real
# secrets. In production (Vercel, or any other host), set these as encrypted
# environment variables / secrets in your hosting provider's dashboard, not in
# a file that ships with the app.
#
# Every value below is fictitious. See README.md for where to get the real
# ones and how to rotate/revoke them.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (formerly called "anon key"). Safe to expose to the
# browser -- every table it can reach is still gated by the RLS policies in
# supabase/migrations.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# The secret service-role key. NEVER prefix this with NEXT_PUBLIC_, never log
# it, never send it to the browser. Bypasses Row Level Security entirely --
# used only by lib/supabase/admin.ts for sync/reconstruction/Notion jobs and
# by scripts/seed-demo-data.ts.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL this app is deployed at (used to build email-confirmation
# redirect links). http://localhost:3000 is correct for local dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Coinbase Advanced Trade / Coinbase Developer Platform (CDP) -- optional
# until Phase 2. Leave unset for Phase 1 (auth, schema, demo data).
# ---------------------------------------------------------------------------
# Create a CDP API key with ONLY the "view" permission -- never "trade" or
# "transfer". See README.md "Coinbase" section for exact steps.
COINBASE_CDP_API_KEY_NAME=organizations/00000000-0000-0000-0000-000000000000/apiKeys/00000000-0000-0000-0000-000000000000
# The full PEM private key CDP shows you ONCE at creation time. Paste it with
# literal newlines preserved (most hosting providers' secret editors handle
# multi-line values directly; for a single-line .env file, use \n escapes and
# make sure your env loader unescapes them -- Next.js's does).
COINBASE_CDP_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\nMHc...\n-----END EC PRIVATE KEY-----\n"

# Which Coinbase futures venue to sync. FCM (Coinbase Financial Markets, US
# CFTC-regulated futures) is the recommended default -- INTX (international
# perpetuals) is being retired by Coinbase on 2026-09-09. See
# docs/COINBASE_INTEGRATION.md.
COINBASE_PRODUCT_VENUE=FCM
# The exact Coinbase product_id you trade, e.g. a dated CFM contract like
# "BIT-27MAR26-CDE", or your CFM perpetual nano contract's product_id. Find it
# on the order ticket in Coinbase Advanced, or via GET /products once you
# have a working read-only key.
#
# Trading more than one contract? List them comma-separated and each is
# synced and reconstructed independently:
#   COINBASE_PRODUCT_ID=BIP-20DEC30-CDE,BIT-27MAR26-CDE
# Anything not listed here is never fetched, so a position opened on an
# unlisted contract simply won't appear in the app.
COINBASE_PRODUCT_ID=BIT-27MAR26-CDE

# ---------------------------------------------------------------------------
# Notion -- fully optional. Used by two independent things: the one-time
# historical backfill (scripts/import-notion-journal.ts, see
# docs/NOTION_IMPORT.md) and the ongoing one-way outbound mirror (Phase 5).
# Leave unset to keep both disabled -- the outbound mirror also stays off
# regardless of the notion_enabled toggle in Settings if these are unset.
# ---------------------------------------------------------------------------
# An internal Notion integration token (Notion -> Settings -> Connections ->
# Develop or manage integrations). Share the target database with this
# integration from Notion's "..." menu -> Connections.
NOTION_API_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The target database's id (the 32-character id in its URL), shared with your
# integration.
NOTION_DATABASE_ID=00000000000000000000000000000000

# ---------------------------------------------------------------------------
# Cron protection -- required once /api/cron/* routes exist (Phase 2+).
# ---------------------------------------------------------------------------
# A long random string. Whatever triggers /api/cron/sync, /api/cron/reconcile,
# /api/cron/monthly-report (Vercel Cron, Supabase pg_cron, or a manual script)
# must send it as "Authorization: Bearer <this value>". Generate with e.g.
# `openssl rand -hex 32`.
CRON_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Optional email alerts (critical problems only)
# ---------------------------------------------------------------------------
# Sends an email when the Coinbase sync fails repeatedly, so a broken sync
# isn't discovered only by opening the app. All three must be set together;
# with any missing, alerting stays off and nothing else changes.
# RESEND_API_KEY is created at resend.com; ALERT_EMAIL_FROM must be an
# address on a domain verified there.
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@tu-dominio.com
ALERT_EMAIL_TO=tu-correo@ejemplo.com
